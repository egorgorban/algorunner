# Postgres connection string — defaults match docker-compose's exposed ports
DATABASE_URL=postgresql://algorunner:algorunner@localhost:5432/algorunner

# Redis broker/result-backend URL — defaults match docker-compose's exposed ports
REDIS_URL=redis://localhost:6379

# Garage (S3-compatible) endpoint — unused until Phase 3 / DATA-02
GARAGE_ENDPOINT=

# OpenAI API key — required, no default. Get one from
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
