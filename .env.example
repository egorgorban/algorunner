# Postgres connection string — defaults match docker-compose's exposed ports
DATABASE_URL=postgresql://algorunner:algorunner@localhost:5432/algorunner

# Redis broker/result-backend URL — defaults match docker-compose's exposed ports
REDIS_URL=redis://localhost:6379

# Garage (S3-compatible) artifact storage endpoint. Empty disables persistence
# (artifacts_incomplete=true in results). For local dev: http://localhost:3900
# For production: replace with actual S3-compatible endpoint
GARAGE_ENDPOINT=http://localhost:3900

# Garage access key — must be "GK" + 24 hex characters for local dev.
# For production: change to actual S3 credentials, do NOT commit to repo
GARAGE_ACCESS_KEY_ID=GK0123456789abcdef01234567

# Garage secret key — must be 64 hex characters for local dev.
# For production: change to actual S3 credentials, do NOT commit to repo
GARAGE_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Garage bucket name for artifact storage
GARAGE_BUCKET=algorunner-artifacts

# Garage region (must match garage.toml s3_region)
GARAGE_REGION=garage

# OpenAI API key — required, no default. Get one from
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Phase 4 D-20: values served to the browser by GET /api/config
CLIENT_API_BASE_URL=/api/v1
CLIENT_WS_BASE_URL=

# Phase 4 API-04 WebSocket guards (T-04-02-02/03)
WS_ALLOWED_ORIGINS=
WS_MAX_CONNECTIONS=200
